generator client {
  provider = "prisma-client-js"
  
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}
model Users {
  id         Int          @id @default(autoincrement())
  createdAt  DateTime     @default(now())
  name       String       @db.VarChar(255)
  last_name  String?      @db.VarChar(255)
  email      String       @unique
  password   String?
  type       UserType     @default(vendeur)
  shop_name  String?    @db.VarChar(255) // Stocker le nom à part aussi
}

enum UserType {
  admin
  vendeur
  gestionnaire
}

  model Shop {
  id     Int    @id @default(autoincrement())
  name   String
  isDelete   Boolean      @default(false)
  logo   String?
}

